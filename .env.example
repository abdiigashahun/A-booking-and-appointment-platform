# Copy this file to .env.local and fill in real values.
# Never commit real secrets — .env* files are gitignored.

# --- Database (Supabase PostgreSQL) ---
# Supabase project identifier and database password.
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_DB_PASSWORD="your-database-password"
# Pooled connection used by the app at runtime.
DATABASE_URL="******aws-0-placeholder.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (non-pooled) connection used by Prisma migrations.
DIRECT_URL="******aws-0-placeholder.pooler.supabase.com:5432/postgres"

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your-key"
SUPABASE_SECRET_KEY="sb_secret_your-key"

# --- Auth.js (next-auth v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="placeholder-generate-a-random-32-byte-secret"
# Base URL of the app (e.g. http://localhost:3000 in development).
AUTH_URL="http://localhost:3000"

# --- Stripe (test mode) ---
STRIPE_SECRET_KEY="sk_test_your-secret-key"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your-publishable-key"
# From `stripe listen` output or the Stripe dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# --- Resend (transactional email) ---
RESEND_API_KEY="re_your-api-key"
# Must be a verified sender/domain in Resend.
EMAIL_FROM="CareSlot <onboarding@resend.dev>"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Clinic ---
# IANA timezone used to display appointment times (stored internally in UTC).
CLINIC_TIMEZONE="Africa/Addis_Ababa"
